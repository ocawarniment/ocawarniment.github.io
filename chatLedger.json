          { "variable": "lessonsBehind", "operator": "greater-than-or-equal-to", "value": 40 }
        ],
        "result": { "state": "adjust", "color": "error", "suggestion": "The student is disengaged; adjust and approve attendance appropriately.", "summary": "" }
